# ===================================================================
# FitLens Environment Configuration Template
# ===================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit real secrets or production .env files to Git.
# 2. Generate a secure random JWT_SECRET_KEY using:
#    .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# 3. Rotating JWT_SECRET_KEY invalidates active sessions; users must log in again.
# ===================================================================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fitlens
MONGO_DB_NAME=fitlens

# JWT Authentication
# Minimum length: 32 bytes (256-bit key for HMAC-SHA256).
# Startup validation will raise a RuntimeError if this value is missing or shorter than 32 bytes.
JWT_SECRET_KEY=GENERATE_A_32_BYTE_OR_LONGER_RANDOM_SECRET

# Email / Password Reset Service (Optional for development)
MAIL_EMAIL=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend and Network
FRONTEND_URL=http://localhost:3000

# Storage Root (Optional; defaults to repository parent directory)
# FITLENS_DATA_ROOT=data
